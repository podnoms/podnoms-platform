# Copy to .env and fill in. Validated at startup by src/env.ts.

# Postgres connection string, e.g. postgres://user:password@localhost:5432/podnoms
DATABASE_URL=

# Where all media (episode audio, images, uploads) is stored (default: ./media),
# and the yt-dlp, ffmpeg and ffprobe binaries (default: found on PATH).
MEDIA_DIR=
YTDLP_PATH=
FFMPEG_PATH=
FFPROBE_PATH=

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public base URL, e.g. https://podnoms.com. Optional in development.
AUTH_URL=

# OAuth callback URLs are <base url>/api/auth/callback/<github|google|facebook>
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=
