# Copy to .env and fill in. Validated at startup by src/env.ts.

# Postgres connection string, e.g. postgres://user:password@localhost:5432/podnoms.
# Leave empty when using Docker Compose's bundled Postgres profile.
DATABASE_URL=

# Where all media (episode audio, images, uploads) is stored (default: ./media),
# and the yt-dlp, ffmpeg and ffprobe binaries (default: found on PATH).
MEDIA_DIR=
YTDLP_PATH=
FFMPEG_PATH=
FFPROBE_PATH=

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public base URL, e.g. https://podnoms.com. Optional in development.
AUTH_URL=

# OAuth callback URLs are <base url>/api/auth/callback/<github|google|facebook>
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# Logging: trace, debug, info (default), warn, error, fatal or silent.
LOG_LEVEL=info
# Errors (server and browser) are sent here when set: a Sentry-compatible DSN,
# e.g. from a self-hosted GlitchTip project. See deploy/observability.
SENTRY_DSN=

# Docker Compose only: required for the bundled Postgres profile when
# DATABASE_URL is empty. Generate a URL-safe password: openssl rand -hex 24
POSTGRES_PASSWORD=

# Docker Compose only: published image and host port (defaults shown).
PODNOMS_IMAGE=ghcr.io/podnoms/podnoms-platform:latest
PORT=3000
