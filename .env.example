# Copy to .env and fill in. Validated at startup by src/env.ts.

# Postgres connection string, e.g. postgres://user:password@localhost:5432/podnoms.
# Leave empty when using Docker Compose's bundled Postgres profile.
DATABASE_URL=

# Where all media (episode audio, images, uploads) is stored (default: ./media),
# and the yt-dlp, ffmpeg and ffprobe binaries (default: found on PATH).
MEDIA_DIR=
YTDLP_PATH=
FFMPEG_PATH=
FFPROBE_PATH=

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# The site's public address, e.g. https://podnoms.com. Optional in development;
# in production it's needed for links in emails sent in the background.
# Sign-in uses it too, so there's no AUTH_URL.
SITE_URL=

# OAuth callback URLs are <base url>/api/auth/callback/<github|google|facebook>
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# Logging: trace, debug, info (default), warn, error, fatal or silent.
LOG_LEVEL=info
# Errors (server and browser) are sent here when set: a Sentry-compatible DSN,
# e.g. from a self-hosted GlitchTip project. See deploy/observability.
SENTRY_DSN=

# Redis for background jobs (e.g. the daily media clean-up). Without it they
# don't run. With Docker Compose's bundled Redis: redis://redis:6379
REDIS_URL=

# Keys for the "Random image" button on artwork, both free and optional:
# Pexels (https://www.pexels.com/api/) is used if set, then Flickr
# (https://www.flickr.com/services/apps/create/, needs a Pro account). Without
# either, photos come from Wikimedia Commons, which needs no key.
PEXELS_API_KEY=
FLICKR_API_KEY=

# A MaxMind account (free: https://www.maxmind.com/en/geolite2/signup) for the
# GeoLite2 database that places listeners by country, region and city in the
# activity stats. Optional: without it, activity has no locations.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# Docker Compose only: required for the bundled Postgres profile when
# DATABASE_URL is empty. Generate a URL-safe password: openssl rand -hex 24
POSTGRES_PASSWORD=

# Docker Compose only: published image and host port (defaults shown).
PODNOMS_IMAGE=ghcr.io/podnoms/podnoms-platform:latest
PORT=3000

# Donation links for the Donate menu in the top nav (signed-in users only).
# The menu is hidden when neither is set.
KOFI_URL=
BITCOIN_ADDRESS=

# An invite link to the community Discord server (e.g. https://discord.gg/...),
# shown in the top nav for signed-in users. Hidden when not set.
DISCORD_SERVER=

# Search engines' site-verification tokens: the `content` of the meta tag that
# Google Search Console / Bing Webmaster Tools ask you to add. Optional.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# A Podcast Index API key with write access (free: https://api.podcastindex.org/),
# so owners can submit their podcast to Podcast Index in one click. Optional.
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=

# An SMTP server for email: password resets and notifications. Optional; when
# SMTP_HOST is set these win, and the admin page's email settings are locked.
# Without them, admins can enter a server on the admin page instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true for TLS from the start (port 465); otherwise STARTTLS when offered.
SMTP_SECURE=false
# Who emails come from, e.g. podnoms <hello@podnoms.com>. Your SMTP server must
# be allowed to send for this domain (verify it with your email provider and add
# its SPF/DKIM DNS records); podnoms can't set that up for you.
EMAIL_FROM=

# Custom domains: owners can serve a podcast from their own domain. Owners point
# a CNAME at CUSTOM_DOMAIN_TARGET (default: SITE_URL's host), plus a TXT record
# proving they own it. Certificates come from the edge container (see
# docker/edge/Caddyfile); Traefik only passes those domains' connections through
# to it, using the routers at /api/traefik/config. See README.md.
CUSTOM_DOMAIN_TARGET=
# The TXT record is _<label>.<domain>, holding <label>-verify=<token>.
CUSTOM_DOMAIN_TXT_LABEL=podnoms
CUSTOM_DOMAIN_EDGE_HOST=
TRAEFIK_TLS_ENTRYPOINT=websecure
TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_CONFIG_TOKEN=

# Live broadcasts: owners stream video from OBS to a MediaMTX server
# (docker/mediamtx/mediamtx.yml, the live profile in compose.yml) and viewers
# watch and chat on the podcast's live page. Off unless all four are set.
# LIVE_SECRET is shared with MediaMTX (openssl rand -base64 32); the API and
# HLS addresses only need to be reachable by the app; LIVE_RTMP_URL is the
# server owners put in OBS. See README.md.
LIVE_SECRET=
LIVE_API_URL=
LIVE_HLS_URL=
LIVE_RTMP_URL=

# GIFs in live chat: a KLIPY key (free, partner.klipy.com) or a GIPHY key
# (developers.giphy.com); KLIPY is used if both are set, and chat has no GIF
# button without either. Viewers' browsers use the key to search the provider
# directly and load GIFs from it, as both providers' terms require.
KLIPY_API_KEY=
GIPHY_API_KEY=

# Azure AI Content Safety, which checks every image coming into the site and
# refuses ones over the limits on the admin page's Moderation tab: the
# resource's endpoint (https://<resource>.cognitiveservices.azure.com/) and
# one of its keys. Images aren't checked without both.
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=

# When the site is behind Cloudflare: the zone ID and an API token with Cache
# Purge permission, so images taken down from reports leave its cache at once.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
